#!/bin/bash
# Pre-push hook: enforce LLM review per AGENTS.md step 8
# Installed via: ./homelab install-hooks
# SOURCE: scripts/pre-push.hook (versioned in Git)

# Exit codes:
#   0 = allow push
#   1 = block push (missing/invalid review verdict)
#   2 = error (misconfigured hook)

set -euo pipefail

# Read the commits being pushed
while read local_ref local_sha remote_ref remote_sha; do
    # Skip if local_sha is all zeros (branch deletion)
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # Determine new commits being pushed
    if git cat-file -t "$remote_sha" >/dev/null 2>&1; then
        # Existing branch: commits between remote and local
        new_commits=$(git rev-list "$remote_sha..$local_sha")
    else
        # New branch: commits not on any remote
        new_commits=$(git rev-list "$local_sha" --not --remotes)
    fi

    for commit in $new_commits; do
        # Skip merge commits (multiple parents)
        parents=$(git log -1 --format=%P "$commit")
        if echo "$parents" | grep -q " "; then
            continue
        fi

        msg=$(git log -1 --format=%B "$commit")

        # Check for explicit verdict marker at start of line
        # Format: "Verdict: APPROVE" or "Verdict: BLOCK → fixed → re-reviewed APPROVE"
        # Accept both Unicode (→) and ASCII (->) arrows
        if ! echo "$msg" | grep -qE '^Verdict: (APPROVE|BLOCK[[:space:]]*(→|->)[[:space:]]*fixed[[:space:]]*(→|->)[[:space:]]*re-reviewed[[:space:]]*APPROVE|REVIEWED)'; then
            echo "❌ PRE-PUSH BLOCKED: Commit $commit missing valid LLM review verdict"
            echo "   Commit subject: $(git log -1 --format=%s "$commit")"
            echo ""
            echo "Per AGENTS.md step 8, you must:"
            echo "  1. Launch reviewer subagent with docs/llm-review.md prompt"
            echo "  2. Get APPROVE verdict (or fix BLOCK findings and re-review)"
            echo "  3. Add verdict line to commit message (or create separate 'review' commit):"
            echo "     Verdict: APPROVE"
            echo "     or"
            echo "     Verdict: BLOCK → fixed → re-reviewed APPROVE"
            echo ""
            echo "To bypass (NOT RECOMMENDED, document justification in report):"
            echo "  git push --no-verify"
            exit 1
        fi
    done
done

exit 0