#!/bin/bash
# Install Git hooks from SOURCE templates
# Usage: ./scripts/install-hooks

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"
HOOKS_DIR="$REPO_ROOT/.git/hooks"

if [ ! -d "$HOOKS_DIR" ]; then
    echo "Error: Not a Git repository or .git/hooks missing" >&2
    exit 1
fi

echo "Installing Git hooks from $SCRIPT_DIR..."

for hook in "$SCRIPT_DIR"/*.hook; do
    if [ -f "$hook" ]; then
        name=$(basename "$hook" .hook)
        cp "$hook" "$HOOKS_DIR/$name"
        chmod +x "$HOOKS_DIR/$name"
        echo "  ✓ Installed $name"
    fi
done

echo "Done. Hooks installed in $HOOKS_DIR"