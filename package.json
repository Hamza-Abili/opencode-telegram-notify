{
  "name": "@hamzaabili/opencode-telegram-notify",
  "version": "0.4.4",
  "description": "OpenCode plugin (v1 and v2): Telegram notifications for permissions, questions, idle and errors, with tap-only inline buttons (never auto-approve).",
  "type": "module",
  "license": "MIT",
  "author": "Hamza-Abili",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v1",
    "opencode-v2",
    "telegram",
    "notifications",
    "notification",
    "questions",
    "permissions",
    "approvals",
    "inline-buttons",
    "bot",
    "monitoring",
    "devops",
    "ai-agent",
    "coding-agent",
    "chatops",
    "mobile",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hamza-Abili/opencode-telegram-notify.git"
  },
  "bugs": {
    "url": "https://github.com/Hamza-Abili/opencode-telegram-notify/issues"
  },
  "main": "./index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./index.ts",
    "./legacy": "./src/legacy.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "ci": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "opencode": ">=1.18 <2 || >=2.0"
  }
}
